---
import { site } from '../../data/site';
import { isPendente, reportar } from '../../lib/pendente';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = site.ogImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// og:image só entra quando houver arquivo real; a pendência é reportada (falha no build estrito).
let ogImage: string | undefined;
if (isPendente(image)) reportar(image);
else ogImage = new URL(image, Astro.site).href;

const sameAs = [site.linkedin];
if (isPendente(site.github)) reportar(site.github);
else sameAs.push(site.github);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.nome,
  jobTitle: site.cargo,
  url: new URL('/', Astro.site).href,
  sameAs,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

---
import { site } from '../../data/site';
import { isPendente } from '../../lib/pendente';
import Pendente from '../ui/Pendente.astro';
---

<footer class="border-t border-border py-8">
  <div class="container-x flex flex-col gap-2 text-small text-text-muted">
    <p>© 2026 {site.nome} · Feito com Astro e Tailwind · Desenvolvido com apoio de agentes de IA</p>
    <p>
      {isPendente(site.repoPortfolio) ? (
        <Pendente id={site.repoPortfolio} />
      ) : (
        <a href={site.repoPortfolio} target="_blank" rel="noopener noreferrer">
          Código deste site<span class="sr-only"> (abre em nova aba)</span>
        </a>
      )}
    </p>
  </div>
</footer>
